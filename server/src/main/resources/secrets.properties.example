# Copy this file to secrets.properties (same folder) and fill in your values.
# secrets.properties is git-ignored, never commit it.

# MongoDB Atlas: Connect > Drivers > Java, then add the database name "/tattoo_studio" before the "?"
spring.mongodb.uri=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tattoo_studio?retryWrites=true&w=majority

# Password for the "admin" staff login, used only when the admin account is first created
app.admin.password=choose-a-strong-password

# Secret that signs staff login tokens: any random text, at least 32 characters
app.jwt.secret=change-me-to-a-long-random-string-of-32-plus-characters

# Optional, for the demo: logins for the three artists (kai, dario, nika) and a demo customer
# (mira@example.com) with this password (8+ characters). Leave it out to create logins yourself.
#app.demo.artist-password=choose-a-demo-password

# Booking emails (optional, skipped without this). For a demo, a free Mailtrap "Email Testing" inbox
# catches every email without delivering it: Mailtrap > Email Testing > Inbox > SMTP credentials.
#spring.mail.host=sandbox.smtp.mailtrap.io
#spring.mail.port=2525
#spring.mail.username=your-mailtrap-username
#spring.mail.password=your-mailtrap-password

# Pictures on Cloudinary (optional; without it they are kept in server/uploads/)
#app.images.cloudinary-url=cloudinary://<api-key>:<api-secret>@<cloud-name>
